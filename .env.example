# LoanIQ Environment Configuration Example

# Flask Backend Server Configuration
FLASK_APP=backend.run:app
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1

# Database Configuration
DATABASE_URL=sqlite:///instance/loaniq.db

# Machine Learning Artifacts Directory
ML_ARTIFACTS_DIR=ml/artifacts
ML_SCHEMAS_DIR=ml/schemas

# Security Salt for Password Hashing (Change in production)
LOANIQ_SECURITY_SALT=loaniq_secure_salt_2026
